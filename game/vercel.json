{
  "cleanUrls": true,
  "rewrites": [{ "source": "/", "destination": "/shadd.html" }],
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(shadd|shadd.html|version.json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/audio/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
